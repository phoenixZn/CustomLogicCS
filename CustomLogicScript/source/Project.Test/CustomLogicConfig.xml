<ConfigSystem>
	<CustomLogicConfig>
	
	<!-- 示例  -->
    <ConfigItem type="CustomLogic">
        <ID>1</ID>
        <Tips>测试</Tips>
        <Node type="RunDSLBhv">
            float:A = 3
        </Node>
        <Node type="RunDSLBhv">
            float:B = 2
            float:C = A - B
        </Node>
        <Node type="ConditionBranchBhv">
            <Condition type="ExpressionCnd" Code="C #LE 0"/>
            <TrueBhv type="FTDelayBhv" TimeLen="1.999"/>
        </Node>
    </ConfigItem>

    <ConfigItem type="CustomLogic">
        <ID>10000</ID>
        <Tips>测试按条件触发的行为节点</Tips>
        <Node type="LogBhv" LogStr="测试 ConditionBranchBhv 节点"/>
        <Node type="ConditionBranchBhv">
            <Condition type="TimeOutCnd" time="2.6"/>
            <TrueBhv type="LogBhv" LogStr="ConditionBranchBhv TrueBhv 调用"/>
        </Node>
    </ConfigItem>

    <ConfigItem type="CustomLogic">
        <ID>10001</ID>
        <Tips>测试SequenceBhv</Tips>
        <Node type="LogBhv" LogStr="测试SequenceBhv节点"/>
        <Node type="SequenceBhv">
            <Node type="FTDelayBhv" TimeLen="3"/>
            <Node type="LogBhv" LogStr="10002 Seq Action 1"/>
            <Node type="FTDelayBhv" TimeLen="3"/>
            <Node type="LogBhv" LogStr="10002 Seq Action 2"/>
        </Node>
    </ConfigItem>
        
    <ConfigItem type="CustomLogic">
        <ID>10002</ID>
        <Tips>测试并行节点</Tips>
        <Node type="LogBhv" LogStr="测试并行节点 ParallelBhv"/>
        <Node type="ParallelBhv">
            <Node type="LogBhv" LogStr="ParallelBhv Begin"/>
            <Node type="SequenceBhv" LoopCnt="4" LoopInterval="2">
                <Node type="LogBhv" LogStr="并行的 Seq1 使用LoopInterval"/>
            </Node>
            <Node type="SequenceBhv" LoopCnt="3">
                <Node type="LogBhv" LogStr="并行的 Seq2"/>
                <Node type="FTDelayBhv" TimeLen="3"/>
            </Node>
        </Node>
	</ConfigItem>

    <ConfigItem type="CustomLogic">
        <ID>10003</ID>
        <Tips>测试LogicTemplete</Tips>
        <Node type="LogBhv" LogStr="测试逻辑模版复用"/>
        <Node type="LogBhv" LogStr="10003 Action 1"/>
        <Node type="LogicTemplete" LogicID="10002"/>
        <Node type="LogBhv" LogStr="10003 Action 2"/>
    </ConfigItem>

    <ConfigItem type="CustomLogic">
        <ID>10004</ID>
        <Tips>测试状态机</Tips>
        <Node type="LogBhv" LogStr="测试状态机 Begin"/>
        <Node type="FSMNode" DefaultState="State_A" RecordCurStateIDTo="CV_CurStateID">
            <!-- State_A -->
            <State type="CustomBhvState" StateID="State_A" NextStateID="State_B">
                <Bhv type="LogBhv" LogStr="State_A Enter"/>
            </State>

            <!-- State_B -->
            <State type="CustomBhvState" StateID="State_B" NextStateID="State_C">
                <Bhv type="SequenceBhv">
                    <Node type="LogBhv" LogStr="State_B Enter"/>
                    <Node type="LogBhv" LogStr="State_B Action..."/>
                    <Node type="FTDelayBhv" TimeLen="2.6"/>
                    <Node type="LogBhv" LogStr="State_B Action Finish"/>
                </Bhv>
                <ExitBhv type="LogBhv" LogStr="State_B Leave"/>
            </State>

            <!-- State_C-->
            <State type="CustomBhvState" StateID="State_C" >
                <Bhv type="LogBhv" LogStr="State_C Enter"/>
            </State>
        </Node>
    </ConfigItem>

    <ConfigItem type="CustomLogic">
        <ID>10005</ID>
        <Tips>测试状态机</Tips>
        <Node type="LogBhv" LogStr="测试状态机 Begin"/>
        <Node type="FSMNode" DefaultState="HST_Idle" RecordCurStateIDTo="CV_CurStateID">
            <!-- TestHeroStateIdle -->
            <State type="TestHeroState" StateID="HST_Idle">
                <Transition type="StateTransitionNode" TrueStateID="HST_Run">
                    <Condition type="TimeOutCnd" time="3.1"/>
                </Transition>
            </State>
            <!-- TestHeroStateRun -->
            <State type="TestHeroState" StateID="HST_Run" NextStateID="HST_Skill">
            </State>
            <!-- TestHeroStateSkill-->
            <State type="TestHeroState" StateID="HST_Skill" >
            </State>
        </Node>
    </ConfigItem>

    <ConfigItem type="CustomLogic">
        <ID>90001</ID>
        <Node type="LogicTemplete" LogicID="90003"/>
        <Node type="LogBhv" LogStr="模板引用1"/>
    </ConfigItem>
    <ConfigItem type="CustomLogic">
        <ID>90002</ID>
        <Node type="LogicTemplete" LogicID="90001"/>
        <Node type="LogBhv" LogStr="模板引用2"/>
    </ConfigItem>
    <ConfigItem type="CustomLogic">
        <ID>90003</ID>
        <Node type="LogicTemplete" LogicID="90002"/>
        <Node type="LogBhv" LogStr="模板引用3"/>
    </ConfigItem>
    

		
	</CustomLogicConfig>
</ConfigSystem>